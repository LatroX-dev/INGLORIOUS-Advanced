; Built only from the exact, verified package file list generated by Build-WindowsInstaller.ps1.
#ifndef AppVersion
  #error AppVersion is required
#endif
#ifndef ApplicationId
  #define ApplicationId "{BC45F6C3-E764-4A57-B683-195C91F063E0}"
#endif
#ifndef ApplicationMutex
  #define ApplicationMutex "INGLORIOUS.Advanced.Running"
#endif
#ifndef StartupValueName
  #define StartupValueName "INGLORIOUS Advanced"
#endif
#ifndef StartupRegistryKey
  #define StartupRegistryKey "Software\Microsoft\Windows\CurrentVersion\Run"
#endif
#ifndef StartupApprovalKey
  #define StartupApprovalKey "Software\Microsoft\Windows\CurrentVersion\Explorer\StartupApproved\Run"
#endif
#ifndef InstallationMutex
  #define InstallationMutex "INGLORIOUS.Advanced.Setup"
#endif
#ifndef UserDataDirectory
  #define UserDataDirectory "{localappdata}\INGLORIOUS Advanced"
#endif
[Setup]
AppId={{#ApplicationId}
AppName=INGLORIOUS Advanced
AppVersion={#AppVersion}
AppPublisher=INGLORIOUS Advanced contributors
AppPublisherURL=https://github.com/LatroX-dev/INGLORIOUS-Advanced
AppSupportURL=https://github.com/LatroX-dev/INGLORIOUS-Advanced/issues
AppUpdatesURL=https://github.com/LatroX-dev/INGLORIOUS-Advanced/releases
DefaultDirName={localappdata}\Programs\INGLORIOUS Advanced
DefaultGroupName=INGLORIOUS Advanced
DisableProgramGroupPage=yes
PrivilegesRequired=lowest
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
MinVersion=10.0.17763
WizardStyle=modern dark includetitlebar
WizardSizePercent=110,110
WizardImageFile={#BrandImage}
WizardSmallImageFile={#BrandSmallImage}
SetupIconFile={#BrandIcon}
UninstallDisplayIcon={app}\INGLORIOUS Advanced.exe
UninstallDisplayName=INGLORIOUS Advanced
UninstallFilesDir={app}\Uninstall
VersionInfoProductName=INGLORIOUS Advanced
VersionInfoDescription=INGLORIOUS Advanced Setup
VersionInfoVersion={#AppVersion}
VersionInfoCompany=INGLORIOUS Advanced contributors
OutputBaseFilename=INGLORIOUS-Advanced-{#AppVersion}-win-x64-Setup
Compression=lzma2/normal
SolidCompression=yes
CloseApplications=no
RestartApplications=no
AllowCancelDuringInstall=no
AppMutex={#ApplicationMutex}
SetupMutex={#InstallationMutex}
DisableWelcomePage=no
DisableDirPage=auto
ShowLanguageDialog=no
LanguageDetectionMethod=uilanguage
UsePreviousLanguage=yes
SetupLogging=no
UninstallLogging=yes

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"
Name: "german"; MessagesFile: "compiler:Languages\German.isl"

[Messages]
english.ConfirmUninstall=Uninstall %1?
german.ConfirmUninstall=Möchtest du %1 deinstallieren?

[CustomMessages]
english.NoticeTitle=Before you install
english.NoticeDescription=Your keyboard settings stay on the keyboard.
english.NoticeText=INGLORIOUS Advanced includes guided firmware setup, an original-firmware backup and restore.%n%nGMMK Numpad uses USB only. Bluetooth does not work with INGLORIOUS firmware.%n%nShared dimming between Numpad and keyboard needs the app running in the background. Stored colors, effects and key bindings work without the app.%n%nThis installer does not change firmware. Automatic startup is optional. Your saved profiles and backups are kept.
english.CloseApp=If a firmware operation is running, wait until it finishes. Save your changes, then right-click the INGLORIOUS icon in the notification area and choose Quit.
english.ProcessCheckFailed=Running applications could not be checked. Right-click the INGLORIOUS icon in the notification area, choose Quit and start setup again.
english.SetupRunning=Another installation or removal is running. Wait until it finishes and try again.
english.LaunchApp=Open INGLORIOUS Advanced
english.DesktopShortcut=Create a desktop shortcut
english.Startup=Open at system startup (notification area)
english.StartupConflict=An existing startup entry belongs to another application location. Leave automatic startup off to keep it unchanged.
english.StartupFailed=Automatic startup could not be changed. You can try again in the app settings.
english.RemoveTitle=Remove INGLORIOUS Advanced
english.KeepData=Remove the app and keep my data
english.RemoveData=Remove the app and all its data
english.DataWarning=This also deletes your profiles, settings, favorites, lighting presets and original-firmware backups. Exported files in other folders are kept.
english.RemoveConfirm=Delete all INGLORIOUS data, including original-firmware backups? This cannot be undone.
english.DataUnsafe=The data folder contains a link or cannot be checked. Your data has not been deleted. Remove the link and try again, or keep your data.
english.DataFailed=Some application data could not be removed. Your remaining files have been kept.
english.RemoveButton=Remove
english.CancelButton=Cancel
german.NoticeTitle=Vor der Installation
german.NoticeDescription=Deine Tastatureinstellungen bleiben auf der Tastatur.
german.NoticeText=INGLORIOUS Advanced enthält die geführte Firmware-Einrichtung sowie Sicherung und Wiederherstellung der Original-Firmware.%n%nDas GMMK Numpad funktioniert nur per USB. Bluetooth ist mit der INGLORIOUS Firmware nicht verfügbar.%n%nGemeinsames Dimmen von Numpad und Tastatur benötigt die App im Hintergrund. Gespeicherte Farben, Effekte und Belegungen funktionieren ohne die App.%n%nDiese Installation ändert keine Firmware. Autostart ist optional. Gespeicherte Profile und Sicherungen bleiben erhalten.
german.CloseApp=Falls gerade ein Firmwarevorgang läuft, warte seinen Abschluss ab. Speichere deine Änderungen. Klicke dann mit der rechten Maustaste auf das INGLORIOUS-Symbol im Infobereich und wähle „Beenden“.
german.ProcessCheckFailed=Laufende Anwendungen konnten nicht geprüft werden. Klicke mit der rechten Maustaste auf das INGLORIOUS-Symbol im Infobereich, wähle „Beenden“ und starte die Installation erneut.
german.SetupRunning=Eine Installation oder Deinstallation läuft bereits. Warte ihren Abschluss ab und versuche es erneut.
german.LaunchApp=INGLORIOUS Advanced öffnen
german.DesktopShortcut=Desktop-Verknüpfung erstellen
german.Startup=Beim Systemstart im Infobereich öffnen
german.StartupConflict=Ein vorhandener Autostart-Eintrag gehört zu einem anderen Anwendungspfad. Lass Autostart ausgeschaltet, um ihn unverändert zu behalten.
german.StartupFailed=Autostart konnte nicht geändert werden. Du kannst es in den App-Einstellungen erneut versuchen.
german.RemoveTitle=INGLORIOUS Advanced entfernen
german.KeepData=App entfernen und meine Daten behalten
german.RemoveData=App und alle zugehörigen Daten entfernen
german.DataWarning=Dabei werden auch Profile, Einstellungen, Favoriten, Beleuchtungsvorlagen und Sicherungen der Original-Firmware gelöscht. Exportierte Dateien in anderen Ordnern bleiben erhalten.
german.RemoveConfirm=Alle INGLORIOUS Daten einschließlich der Original-Firmware-Sicherungen löschen? Das lässt sich nicht rückgängig machen.
german.DataUnsafe=Der Datenordner enthält eine Verknüpfung oder kann nicht geprüft werden. Deine Daten wurden nicht gelöscht. Entferne die Verknüpfung und versuche es erneut oder behalte die Daten.
german.DataFailed=Einige Anwendungsdaten konnten nicht entfernt werden. Die übrigen Dateien bleiben erhalten.
german.RemoveButton=Entfernen
german.CancelButton=Abbrechen

[Tasks]
Name: "desktopicon"; Description: "{cm:DesktopShortcut}"; Flags: unchecked
Name: "startup"; Description: "{cm:Startup}"

[Files]
#include FileList

[Icons]
Name: "{group}\INGLORIOUS Advanced"; Filename: "{app}\INGLORIOUS Advanced.exe"; WorkingDir: "{app}"
Name: "{userdesktop}\INGLORIOUS Advanced"; Filename: "{app}\INGLORIOUS Advanced.exe"; WorkingDir: "{app}"; Tasks: desktopicon

[Run]
Filename: "{app}\INGLORIOUS Advanced.exe"; Description: "{cm:LaunchApp}"; Flags: nowait postinstall skipifsilent unchecked

[Code]
const StartupKey = '{#StartupRegistryKey}';
var PreviousApplicationPath: String;
    StartupInitialized: Boolean;
    RemovePersonalData: Boolean;
    UninstallMutex: THandle;

function NativeCreateMutex(Attributes: THandle; InitialOwner: Boolean; Name: String): THandle;
  external 'CreateMutexW@kernel32.dll stdcall';
function NativeCloseHandle(Handle: THandle): Boolean;
  external 'CloseHandle@kernel32.dll stdcall';

function SafeDataTree(const Folder: String; Depth: Integer): Boolean;
var Find: TFindRec; Child: String;
begin
  Result := False;
  if Depth > 64 then Exit;
  if FindFirst(Folder, Find) then begin
    try
      if (Find.Attributes and FILE_ATTRIBUTE_REPARSE_POINT) <> 0 then Exit;
    finally FindClose(Find); end;
  end else begin
    Result := not DirExists(Folder) and not FileExists(Folder);
    Exit;
  end;
  if FindFirst(AddBackslash(Folder) + '*', Find) then begin
    try
      repeat
        if (Find.Name <> '.') and (Find.Name <> '..') then begin
          if (Find.Attributes and FILE_ATTRIBUTE_REPARSE_POINT) <> 0 then Exit;
          if (Find.Attributes and FILE_ATTRIBUTE_DIRECTORY) <> 0 then begin
            Child := AddBackslash(Folder) + Find.Name;
            if not SafeDataTree(Child, Depth + 1) then Exit;
          end;
        end;
      until not FindNext(Find);
    finally FindClose(Find); end;
  end;
  Result := True;
end;

function SafeDataRoot: Boolean;
var Folder, Parent: String; Find: TFindRec;
begin
  Result := False;
  Folder := ExpandConstant('{#UserDataDirectory}');
  if (Length(Folder) < 8) or (Folder[2] <> ':') or (Folder[3] <> '\') then Exit;
  Parent := Folder;
  while Length(Parent) > 3 do begin
    if FindFirst(Parent, Find) then begin
      try
        if (Find.Attributes and FILE_ATTRIBUTE_REPARSE_POINT) <> 0 then Exit;
      finally FindClose(Find); end;
    end;
    Parent := ExtractFileDir(Parent);
  end;
  Result := SafeDataTree(Folder, 0);
end;

function ChooseUninstallData: Boolean;
var Form: TSetupForm; Keep, Remove: TNewRadioButton;
    Warning: TNewStaticText; ContinueButton, CancelButton: TNewButton;
begin
  RemovePersonalData := False;
  Result := True;
  if UninstallSilent then begin
    { Public silent uninstall always keeps data. Only the isolated test build
      accepts this test-only switch against its compiled fake data directory. }
    #ifdef TestInstallerMode
      RemovePersonalData := ExpandConstant('{param:TESTREMOVEUSERDATA|0}') = '1';
    #endif
    Exit;
  end;
  Form := CreateCustomForm(ScaleX(490), ScaleY(255), False, False);
  try
    Form.Caption := CustomMessage('RemoveTitle');
    Keep := TNewRadioButton.Create(Form); Keep.Parent := Form;
    Keep.SetBounds(ScaleX(22), ScaleY(28), ScaleX(450), ScaleY(24));
    Keep.Caption := CustomMessage('KeepData'); Keep.Checked := True;
    Remove := TNewRadioButton.Create(Form); Remove.Parent := Form;
    Remove.SetBounds(ScaleX(22), ScaleY(68), ScaleX(450), ScaleY(24));
    Remove.Caption := CustomMessage('RemoveData');
    Warning := TNewStaticText.Create(Form); Warning.Parent := Form;
    Warning.SetBounds(ScaleX(42), ScaleY(105), ScaleX(420), ScaleY(84));
    Warning.AutoSize := False; Warning.WordWrap := True;
    Warning.Caption := CustomMessage('DataWarning');
    ContinueButton := TNewButton.Create(Form); ContinueButton.Parent := Form;
    ContinueButton.SetBounds(ScaleX(348), ScaleY(212), ScaleX(120), ScaleY(27));
    ContinueButton.Caption := CustomMessage('RemoveButton'); ContinueButton.ModalResult := mrOk;
    CancelButton := TNewButton.Create(Form); CancelButton.Parent := Form;
    CancelButton.SetBounds(ScaleX(220), ScaleY(212), ScaleX(120), ScaleY(27));
    CancelButton.Caption := CustomMessage('CancelButton'); CancelButton.ModalResult := mrCancel;
    CancelButton.Cancel := True;
    Result := Form.ShowModal = mrOk;
    if Result and Remove.Checked then begin
      Result := MsgBox(CustomMessage('RemoveConfirm'), mbConfirmation, MB_YESNO or MB_DEFBUTTON2) = IDYES;
      RemovePersonalData := Result;
    end;
  finally Form.Free; end;
end;

function ApplicationCommand: String;
begin
  Result := '"' + ExpandConstant('{app}\INGLORIOUS Advanced.exe') + '" --background';
end;

function OwnStartupValue(const Value: String): Boolean;
begin
  Result := (CompareText(Value, ApplicationCommand) = 0) or
    (CompareText(Value, '"' + ExpandConstant('{app}\INGLORIOUS Advanced.exe') + '"') = 0) or
    ((PreviousApplicationPath <> '') and ((CompareText(Value, '"' + PreviousApplicationPath + '"') = 0) or
      (CompareText(Value, '"' + PreviousApplicationPath + '" --background') = 0)));
end;

function ForeignStartupValue: Boolean;
var Value: String;
begin
  Result := RegValueExists(HKCU, StartupKey, '{#StartupValueName}') and
    (not RegQueryStringValue(HKCU, StartupKey, '{#StartupValueName}', Value) or not OwnStartupValue(Value));
end;

function RunningApplication: Boolean;
var Locator, Service, Processes: Variant; Query, AppPath: String;
begin
  Result := True;
  Locator := CreateOleObject('WbemScripting.SWbemLocator');
  Service := Locator.ConnectServer('', 'root\CIMV2');
  Query := 'SELECT ProcessId FROM Win32_Process WHERE Name = ''INGLORIOUS Advanced.exe'' OR Name = ''InGlorious Core.exe'' OR Name = ''InGlorious.FirmwareAdapter.exe''';
  #ifdef TestInstallerMode
    { Isolated fixtures must not collide with unrelated application or backend tests. }
    AppPath := ExpandConstant('{app}\');
    StringChangeEx(AppPath, '\', '\\', True);
    StringChangeEx(AppPath, '''', '\''', True);
    Query := 'SELECT ProcessId FROM Win32_Process WHERE (Name = ''INGLORIOUS Advanced.exe'' OR Name = ''InGlorious Core.exe'' OR Name = ''InGlorious.FirmwareAdapter.exe'') AND ExecutablePath LIKE ''' + AppPath + '%''';
  #endif
  Processes := Service.ExecQuery(Query);
  Result := Processes.Count > 0;
end;

function PrepareToInstall(var NeedsRestart: Boolean): String;
begin
  Result := '';
  try
    if CheckForMutexes('{#ApplicationMutex}') or RunningApplication then
      Result := CustomMessage('CloseApp')
    else if WizardIsTaskSelected('startup') and ForeignStartupValue then
      Result := CustomMessage('StartupConflict');
  except
    Result := CustomMessage('ProcessCheckFailed');
  end;
end;

function InitializeUninstall: Boolean;
var LastError: LongWord; Waits: Integer;
begin
  Result := False;
  try
    { SetupMutex is a Setup directive. The uninstaller holds the same named
      object before checking the app and until this process exits. }
    UninstallMutex := NativeCreateMutex(0, False, '{#InstallationMutex}');
    LastError := DLLGetLastError;
    if (UninstallMutex = 0) or (LastError = 183) then begin
      SuppressibleMsgBox(CustomMessage('SetupRunning'), mbInformation, MB_OK, IDOK);
      Exit;
    end;
    #ifdef TestInstallerMode
      if ExpandConstant('{param:TESTPAUSEUNINSTALL|0}') = '1' then begin
        SaveStringToFile(ExpandConstant('{#UserDataDirectory}') + '.uninstall-ready', 'ready', False);
        Waits := 0;
        while not FileExists(ExpandConstant('{#UserDataDirectory}') + '.uninstall-continue') do begin
          Sleep(50); Waits := Waits + 1;
          if Waits > 1200 then Exit;
        end;
      end;
      if ExpandConstant('{param:TESTCANCELUNINSTALL|0}') = '1' then Exit;
    #endif
    if CheckForMutexes('{#ApplicationMutex}') or RunningApplication then
      SuppressibleMsgBox(CustomMessage('CloseApp'), mbInformation, MB_OK, IDOK)
    else begin
      Result := ChooseUninstallData;
      if Result and RemovePersonalData and not SafeDataRoot then begin
        SuppressibleMsgBox(CustomMessage('DataUnsafe'), mbError, MB_OK, IDOK);
        Result := False;
      end;
    end;
  except
    SuppressibleMsgBox(CustomMessage('ProcessCheckFailed'), mbError, MB_OK, IDOK);
  end;
end;

procedure DeinitializeUninstall;
begin
  if UninstallMutex <> 0 then begin
    NativeCloseHandle(UninstallMutex);
    UninstallMutex := 0;
  end;
end;

procedure InitializeWizard;
var Notice: TOutputMsgWizardPage;
begin
  PreviousApplicationPath := GetPreviousData('ApplicationPath', '');
  #ifdef TestInstallerMode
    Log('Test uninstall confirmation: ' + SetupMessage(msgConfirmUninstall));
  #endif
  Notice := CreateOutputMsgPage(wpWelcome, CustomMessage('NoticeTitle'),
    CustomMessage('NoticeDescription'), CustomMessage('NoticeText'));
end;

procedure CurPageChanged(CurPageID: Integer);
var Value: String;
begin
  if (CurPageID = wpSelectTasks) and not StartupInitialized then begin
    StartupInitialized := True;
    { A deliberate command-line choice is honored, but still checked for ownership. }
    if (Pos('/TASKS=', UpperCase(GetCmdTail)) = 0) and (Pos('/MERGETASKS=', UpperCase(GetCmdTail)) = 0) then begin
      if RegQueryStringValue(HKCU, StartupKey, '{#StartupValueName}', Value) and OwnStartupValue(Value) then
        WizardSelectTasks('startup')
      else if (PreviousApplicationPath <> '') or RegValueExists(HKCU, StartupKey, '{#StartupValueName}') then
        WizardSelectTasks('!startup');
    end;
  end;
end;

procedure RegisterPreviousData(PreviousDataKey: Integer);
begin
  SetPreviousData(PreviousDataKey, 'ApplicationPath', ExpandConstant('{app}\INGLORIOUS Advanced.exe'));
end;

procedure CurStepChanged(CurStep: TSetupStep);
var Value: String; Changed: Boolean;
begin
  if CurStep = ssPostInstall then begin
    Changed := True;
    if WizardIsTaskSelected('startup') then begin
      { Recheck immediately before writing; an unrelated value is never overwritten. }
      if ForeignStartupValue then Changed := False
      else Changed := RegWriteStringValue(HKCU, StartupKey, '{#StartupValueName}', ApplicationCommand);
    end else if RegQueryStringValue(HKCU, StartupKey, '{#StartupValueName}', Value) and OwnStartupValue(Value) then
      Changed := RegDeleteValue(HKCU, StartupKey, '{#StartupValueName}');
    if not Changed then SuppressibleMsgBox(CustomMessage('StartupFailed'), mbInformation, MB_OK, IDOK);
  end;
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
var Value: String;
begin
  if (CurUninstallStep = usUninstall) and RemovePersonalData and not ForeignStartupValue and
    RegValueExists(HKCU, '{#StartupApprovalKey}', '{#StartupValueName}') then
      if not RegDeleteValue(HKCU, '{#StartupApprovalKey}', '{#StartupValueName}') then
        SuppressibleMsgBox(CustomMessage('DataFailed'), mbInformation, MB_OK, IDOK);
  if (CurUninstallStep = usUninstall) and
    RegQueryStringValue(HKCU, StartupKey, '{#StartupValueName}', Value) and
    OwnStartupValue(Value) then
      RegDeleteValue(HKCU, StartupKey, '{#StartupValueName}');
  if (CurUninstallStep = usUninstall) and RemovePersonalData then begin
    if not SafeDataRoot then
      RaiseException(CustomMessage('DataUnsafe'));
    if DirExists(ExpandConstant('{#UserDataDirectory}')) and not DelTree(ExpandConstant('{#UserDataDirectory}'), True, True, True) then
      SuppressibleMsgBox(CustomMessage('DataFailed'), mbInformation, MB_OK, IDOK);
  end;
end;
