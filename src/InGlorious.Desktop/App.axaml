<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="InGlorious.Desktop.App" RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
    <Style Selector="Window"><Setter Property="Background" Value="#141618" /><Setter Property="Foreground" Value="#E4E7EB" /><Setter Property="FontSize" Value="13" /></Style>
    <Style Selector="Button"><Setter Property="MinHeight" Value="34" /><Setter Property="CornerRadius" Value="3" /><Setter Property="Padding" Value="12,7" /><Setter Property="Background" Value="#22262A" /><Setter Property="BorderBrush" Value="#353A40" /><Setter Property="BorderThickness" Value="1" /></Style>
    <Style Selector="Button.nav"><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="#2C3137" /></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="#C64852" /><Setter Property="Foreground" Value="White" /></Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="#2D3339" /><Setter Property="BorderBrush" Value="#747E8A" /></Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="#D85260" /><Setter Property="BorderBrush" Value="#EF646B" /></Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter"><Setter Property="Background" Value="#A73542" /></Style>
    <Style Selector="TextBox"><Setter Property="MinHeight" Value="34" /><Setter Property="CornerRadius" Value="3" /></Style>
    <Style Selector="ComboBox"><Setter Property="MinHeight" Value="34" /><Setter Property="HorizontalAlignment" Value="Stretch" /></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#A0A7B0" /></Style>
    <Style Selector="TextBlock.section"><Setter Property="FontSize" Value="15" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="0,14,0,7" /></Style>
  </Application.Styles>
  <Application.Resources><Color x:Key="SystemAccentColor">#EF646B</Color></Application.Resources>
</Application>
