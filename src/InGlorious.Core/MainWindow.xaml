<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:InGlorious.Core" x:Class="InGlorious.Core.MainWindow" Title="INGLORIOUS Advanced" Icon="Assets/inglorious.ico" Foreground="{StaticResource Text}" Width="1536" Height="960" MinWidth="1150" MinHeight="760" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown" SizeChanged="Window_SizeChanged" Closed="Window_Closed">
    <Window.Resources>
        <Style x:Key="OptionalHelp" TargetType="TextBlock" BasedOn="{StaticResource HelpText}">
            <Setter Property="Visibility" Value="{DynamicResource HelpVisibility}" />
        </Style>
    </Window.Resources>
    <Grid x:Name="EditorSurface" Background="{StaticResource WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="70" />
        </Grid.RowDefinitions>
        <Border Background="#1C1F22" BorderBrush="#353A40" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/inglorious-mark.png" Width="40" Height="40" Stretch="Uniform" Margin="0,0,11,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="BrandWordmark" Text="INGLORIOUS" FontFamily="pack://application:,,,/Assets/Fonts/#IG Preview Oxanium" FontSize="20" FontWeight="SemiBold" Foreground="#F0F1F3" LineHeight="23" />
                        <TextBlock Text="ADVANCED" FontFamily="Bahnschrift" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="1,-3,0,0" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SoftwareUpdateNotice" Content="{local:Tr Key='Update verfügbar'}" Visibility="Collapsed" Margin="0,0,16,0" Click="SoftwareUpdate_Click" Style="{StaticResource QuietButton}" Foreground="{StaticResource Accent}" />
                    <Button x:Name="UndoButton" Content="↶" FontSize="22" Width="35" Padding="0" Margin="0,0,3,0" Click="Undo_Click" ToolTip="{local:Tr Key='Rückgängig · Strg+Z'}" Style="{StaticResource QuietButton}" />
                    <Button x:Name="RedoButton" Content="↷" FontSize="22" Width="35" Padding="0" Margin="0,0,14,0" Click="Redo_Click" ToolTip="{local:Tr Key='Wiederholen · Strg+Y'}" Style="{StaticResource QuietButton}" />
                    <Button x:Name="HelpButton" Content="?" FontSize="20" FontWeight="SemiBold" Width="38" Height="36" Padding="0" Margin="0,0,3,0" Click="Help_Click" ToolTip="{local:Tr Key='Anleitung'}" AutomationProperties.Name="{local:Tr Key='Anleitung'}" Style="{StaticResource QuietButton}" />
                    <Button x:Name="SettingsButton" Content="" FontFamily="Segoe MDL2 Assets" FontSize="18" Width="38" Height="36" Padding="0" Click="Settings_Click" ToolTip="{local:Tr Key='Einstellungen'}" AutomationProperties.Name="{local:Tr Key='Einstellungen'}" Style="{StaticResource QuietButton}" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="194" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>
            <Border Background="#1C1F22" BorderBrush="#353A40" BorderThickness="0,0,1,0">
                <DockPanel Margin="12,22,12,14">
                    <Button local:UiIcons.Kind="refresh" DockPanel.Dock="Bottom" Content="{local:Tr Key='Geräte neu suchen'}" Click="Scan_Click" Style="{StaticResource QuietButton}" FontSize="11" />
                    <StackPanel>
                        <TextBlock Text="{local:Tr Key='Geräte'}" Style="{StaticResource Eyebrow}" Margin="8,0,0,12" />
                        <StackPanel x:Name="DeviceButtons" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="240">
                            <StackPanel x:Name="SetupDeviceButtons" />
                        </ScrollViewer>
                        <TextBlock x:Name="DeviceModeText" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="4,7,4,0" />
                        <TextBlock x:Name="ConnectionText" Visibility="Collapsed" />
                        <Border Style="{StaticResource PanelDivider}" />
                        <Button local:UiIcons.Kind="light" x:Name="ColorTab" Content="{local:Tr Key='Beleuchtung'}" Click="ColorTab_Click" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left" Padding="14,12" Margin="0,0,0,4" BorderThickness="2,0,0,0" />
                        <Button local:UiIcons.Kind="keyboard" x:Name="BindingTab" Content="{local:Tr Key='Tastenbelegung'}" Click="BindingTab_Click" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left" Padding="14,12" Margin="0,0,0,4" BorderThickness="2,0,0,0" />
                        <Button local:UiIcons.Kind="layers" x:Name="LayerTab" Content="{local:Tr Key='Ebenen'}" Click="LayerTab_Click" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left" Padding="14,12" Margin="0,0,0,4" BorderThickness="2,0,0,0" />
                        <Button local:UiIcons.Kind="macro" x:Name="MacroTab" Content="{local:Tr Key='Makros'}" Click="MacroTab_Click" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left" Padding="14,12" Margin="0,0,0,4" BorderThickness="2,0,0,0" />
                        <Button local:UiIcons.Kind="folder" x:Name="ProfilesTab" Content="{local:Tr Key='Profile'}" Click="ProfilesTab_Click" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left" Padding="14,12" BorderThickness="2,0,0,0" Margin="0,0,0,4" />
                        <Button local:UiIcons.Kind="settings" x:Name="DeviceTab" Content="{local:Tr Key='Gerät'}" Click="DeviceTab_Click" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left" Padding="14,12" Margin="0,8,0,0" BorderThickness="2,0,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Grid Grid.Column="1" Margin="24,22,24,16">
                <ScrollViewer x:Name="WorkspaceScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="WorkspaceHeadingHost" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock x:Name="WorkspaceHeading" Text="{local:Tr Key='Tastatur'}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="ExperimentalDeviceLabel" Text="{local:Tr Key='Experimentell'}" Foreground="#E9B86B" FontSize="11" Margin="0,4,0,0" Visibility="Collapsed" />
                            </StackPanel>
                            <StackPanel x:Name="HardwareSwitchHost" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="4,0,20,0" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel x:Name="HardwareOsPosition" Orientation="Horizontal" ToolTip="{local:Tr Key='Stellung des Windows/Mac-Schalters an deiner Tastatur.'}">
                                        <Path Data="M4,5 L18,5 Q22,5 22,9 L22,15 Q22,19 18,19 L4,19 Q0,19 0,15 L0,9 Q0,5 4,5 Z M7,9 A3,3 0 1 1 7,15 A3,3 0 1 1 7,9" Width="18" Height="16" Stretch="Uniform" Stroke="#A0A7B0" StrokeThickness="1.5" Margin="0,0,6,0" />
                                        <TextBlock x:Name="HardwareOsValue" Text="—" FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel x:Name="HardwareProfilePosition" Orientation="Horizontal" Margin="14,0,0,0" Visibility="Collapsed" ToolTip="{local:Tr Key='Stellung des Profilschalters an deiner Tastatur.'}">
                                        <Path Data="M2,6 L22,6 L22,18 L2,18 Z M7,6 L7,18 M17,6 L17,18 M10,9 L14,9 L14,15 L10,15 Z" Width="18" Height="16" Stretch="Uniform" Stroke="#A0A7B0" StrokeThickness="1.5" Margin="0,0,6,0" />
                                        <TextBlock x:Name="HardwareProfileValue" Text="—" FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock x:Name="HardwareSwitchPending" Foreground="{StaticResource Muted}" FontSize="11" MaxWidth="200" TextWrapping="Wrap" Margin="0,5,0,0" Visibility="Collapsed" />
                            </StackPanel>
                            <Label Grid.Column="2" Content="{local:Tr Key='Ebene bearbeiten'}" Target="{Binding ElementName=CurrentLayerChoice}" Foreground="{StaticResource Muted}" FontSize="11" Padding="0" Margin="0,0,0,6" Visibility="{Binding ElementName=CurrentLayerHost, Path=Visibility}" />
                            <StackPanel x:Name="CurrentLayerHost" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center">
                                <ComboBox x:Name="CurrentLayerChoice" SelectionChanged="CurrentLayer_SelectionChanged" ToolTip="{local:Tr Key='Ebene bearbeiten'}" />
                            </StackPanel>
                            <StackPanel x:Name="LayerEditingHelp" Grid.Row="2" Grid.ColumnSpan="3" Margin="0,10,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="LayerEditingHint" Style="{StaticResource HelpText}" />
                                <TextBlock x:Name="LayerSummaryHint" Style="{StaticResource HelpText}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Row="1">
                        <StackPanel x:Name="EmptyDeviceSetup" Visibility="Collapsed" Margin="0,14,0,0">
                            <Button Content="{local:Tr Key='Gerät einrichten'}" local:UiIcons.Kind="chip" Click="SetupDevice_Click" HorizontalAlignment="Left" />
                        </StackPanel>
                        <Border x:Name="SafetyBanner" Visibility="Collapsed" Background="#382629" Padding="12" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock x:Name="ProjectSourceText" Text="{local:Tr Key='Profil konnte nicht geladen werden'}" Foreground="#FFA3A8" FontWeight="SemiBold" />
                                <TextBlock x:Name="ProjectSourceHint" Style="{StaticResource HelpText}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        </StackPanel>
                        <StackPanel x:Name="KeyboardWorkspace" Grid.Row="2">
                            <StackPanel x:Name="LayerOverview" Visibility="Collapsed" Margin="0,14,0,0">
                                <UniformGrid x:Name="LayerCards" Columns="2" />
                            </StackPanel>
                            <Button x:Name="BackToMacroButton" Content="{local:Tr Key='← Zurück zum Makro'}" Click="BackToMacro_Click" HorizontalAlignment="Left" Visibility="Collapsed" Margin="0,14,0,0" />
                            <Border x:Name="KeyboardPanel" Background="#171A1D" BorderBrush="#30363C" BorderThickness="1" CornerRadius="3" MinHeight="280" Margin="0,14,0,10">
                                <Grid x:Name="KeyboardPanelInner" Margin="19,18,19,17">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock x:Name="PreviewDeviceName" Text="" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock x:Name="PreviewLayerName" Text="{local:Tr Key='ISO · Ebene 0'}" Foreground="#A0A7B0" FontSize="11" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{local:Tr Key='Vorschau'}" FontSize="10" FontWeight="SemiBold" Foreground="#A0A7B0" Margin="8,3,0,0" />
                                    </Grid>
                                    <Viewbox x:Name="KeyboardView" Grid.Row="1" Stretch="Uniform" StretchDirection="Both" Margin="0,26,0,24" MaxHeight="405">
                                        <Border Background="#252A2F" BorderBrush="#49535E" BorderThickness="1" CornerRadius="7" Padding="14">
                                            <Canvas x:Name="KeyboardCanvas" />
                                        </Border>
                                    </Viewbox>
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{local:Tr Key='Klicken zum Auswählen · Umschalt für mehrere'}" Foreground="#A0A7B0" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    </Grid>
                                </Grid>
                            </Border>
                        <Grid x:Name="SelectionBar" Margin="2,0,2,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SelectionText" Text="{local:Tr Key='Keine Taste ausgewählt'}" Foreground="#A0A7B0" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0" />
                            <WrapPanel Grid.Column="1" x:Name="SelectionActions">
                                <Button x:Name="SelectAllButton" local:UiIcons.Kind="select" Content="{local:Tr Key='Alle auswählen'}" Click="SelectAll_Click" Padding="8,7" FontSize="11" Style="{StaticResource QuietButton}" />
                                <Button x:Name="ClearSelectionButton" local:UiIcons.Kind="clear" Content="{local:Tr Key='Auswahl aufheben'}" Click="ClearSelection_Click" Style="{StaticResource QuietButton}" Padding="8,7" FontSize="11" Margin="6,0,0,0" />
                            </WrapPanel>
                        </Grid>
                        </StackPanel>
                        <Border x:Name="DeviceOverview" VerticalAlignment="Top" Grid.Row="2" Visibility="Collapsed" Margin="0,24,0,14">
                            <StackPanel>
                                <TextBlock x:Name="DevicePendingEditsHint" Text="{Binding Text, ElementName=PendingEditsHint}" Visibility="{Binding Visibility, ElementName=PendingEditsHint}" Foreground="{StaticResource Accent}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,14" />
                                <Grid x:Name="DeviceSettingsPanel" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="48" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{local:Tr Key='Reaktionszeit'}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,18" />
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="20" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{local:Tr Key='USB-Abfragerate'}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                                                <ComboBox x:Name="PollingChoice" SelectedValuePath="Tag">
                                                    <ComboBoxItem Content="{local:Tr Key='1000 Hz · 1 ms'}" Tag="1" />
                                                    <ComboBoxItem Content="{local:Tr Key='500 Hz · 2 ms'}" Tag="2" />
                                                    <ComboBoxItem Content="{local:Tr Key='250 Hz · 4 ms'}" Tag="4" />
                                                    <ComboBoxItem Content="{local:Tr Key='125 Hz · 8 ms'}" Tag="8" />
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{local:Tr Key='Entprellzeit'}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBox x:Name="DebounceInput" Text="5" MaxLength="2" ToolTip="{local:Tr Key='Entprellzeit von 0 bis 40 Millisekunden'}" />
                                                    <TextBlock Grid.Column="1" Text="{local:Tr Key='ms'}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="9,0,0,0" />
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{local:Tr Key='0–40 ms · Standard: 5 ms. Niedrige Werte können bei prellenden Schaltern doppelte Eingaben verursachen.'}" Style="{StaticResource OptionalHelp}" Margin="0,12,0,0" />
                                        <TextBlock Text="{local:Tr Key='Nach einer Änderung meldet sich das Gerät kurz per USB neu an. Umstecken ist nicht nötig.'}" Style="{StaticResource OptionalHelp}" Margin="0,9,0,0" />
                                        <TextBlock Text="{local:Tr Key='Gilt für alle Ebenen dieses Geräts. USB-Abfragerate und Entprellzeit sind keine Messung der gesamten Eingabelatenz.'}" Style="{StaticResource OptionalHelp}" Margin="0,9,0,0" />
                                        <Button x:Name="ApplyTimingButton" local:UiIcons.Kind="check" Content="{local:Tr Key='Einstellungen übernehmen'}" Click="ApplyDeviceSettings_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" MinWidth="180" Margin="0,18,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="1" Background="{StaticResource Stroke}" Margin="0,0,0,0" />
                                    <StackPanel x:Name="StandbyPanel" Grid.Column="2">
                                        <Grid Margin="0,0,0,18">
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{local:Tr Key='Beleuchtung bei Inaktivität'}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                                            <ToggleButton x:Name="StandbyEnabled" Grid.Column="1" Style="{StaticResource SwitchToggle}" ToolTip="{local:Tr Key='Standby aktivieren'}" AutomationProperties.Name="{local:Tr Key='Standby aktivieren'}" VerticalAlignment="Center" />
                                        </Grid>
                                        <StackPanel x:Name="StandbyOptions">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="20" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{local:Tr Key='Wartezeit'}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                                                    <ComboBox x:Name="StandbyTimeChoice" SelectedValuePath="Tag" SelectionChanged="StandbyTime_Changed">
                                                        <ComboBoxItem Content="{local:Tr Key='30 Sekunden'}" Tag="30" />
                                                        <ComboBoxItem Content="{local:Tr Key='1 Minute'}" Tag="60" />
                                                        <ComboBoxItem Content="{local:Tr Key='2 Minuten'}" Tag="120" />
                                                        <ComboBoxItem Content="{local:Tr Key='5 Minuten'}" Tag="300" />
                                                        <ComboBoxItem Content="{local:Tr Key='10 Minuten'}" Tag="600" />
                                                        <ComboBoxItem Content="{local:Tr Key='30 Minuten'}" Tag="1800" />
                                                        <ComboBoxItem Content="{local:Tr Key='60 Minuten'}" Tag="3600" />
                                                        <ComboBoxItem Content="{local:Tr Key='Eigene Zeit'}" Tag="custom" />
                                                    </ComboBox>
                                                    <Grid x:Name="StandbyCustomTimePanel" Visibility="Collapsed" Margin="0,9,0,0">
                                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <TextBox x:Name="StandbySeconds" Text="300" MaxLength="5" />
                                                        <TextBlock Grid.Column="1" Text="{local:Tr Key='Sekunden'}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                    </Grid>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{local:Tr Key='Aktion'}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                                                    <ComboBox x:Name="StandbyMode" SelectedIndex="0">
                                                        <ComboBoxItem Content="{local:Tr Key='Aus'}" /><ComboBoxItem Content="{local:Tr Key='Dimmen'}" /><ComboBoxItem Content="{local:Tr Key='Screensaver'}" />
                                                    </ComboBox>
                                                    <Grid x:Name="StandbyBrightnessPanel" Margin="0,9,0,0">
                                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="85" /></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{local:Tr Key='Helligkeit (%)'}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0,0,8,0" TextWrapping="Wrap" />
                                                        <TextBox x:Name="StandbyBrightness" Grid.Column="1" Text="10" MaxLength="3" />
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="{local:Tr Key='Nach der letzten Eingabe an diesem Gerät.'}" Style="{StaticResource OptionalHelp}" Margin="0,9,0,0" />
                                            <TextBlock x:Name="StandbyScreensaverHint" Text="{local:Tr Key='Nach der Wartezeit wiederholt sich die vollständige Lichtsequenz bis zur nächsten Eingabe.'}" Visibility="Collapsed" Style="{StaticResource HelpText}" Margin="0,9,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="{local:Tr Key='Gilt für das gesamte Gerät und läuft ohne geöffnete App.'}" Style="{StaticResource HelpText}" Margin="0,12,0,0" />
                                        <TextBlock Text="{local:Tr Key='Tasten, Drehknopf oder Schieberegler wecken die Beleuchtung wieder auf.'}" Style="{StaticResource HelpText}" Margin="0,5,0,0" />
                                        <TextBlock Text="{local:Tr Key='Im USB-Ruhezustand bleibt die Beleuchtung aus.'}" Style="{StaticResource HelpText}" Margin="0,5,0,0" />
                                        <Border x:Name="ApplyStandbyHost" HorizontalAlignment="Left" MinWidth="180" Margin="0,18,0,0">
                                            <Button local:UiIcons.Kind="check" Content="{local:Tr Key='Übernehmen'}" Click="ApplyStandby_Click" Style="{StaticResource PrimaryButton}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <Border Style="{StaticResource PanelDivider}" Margin="0,28,0,24" />
                                <TextBlock x:Name="ExperimentalDeviceNotice" Text="{local:Tr Key='Experimentelle Unterstützung: noch nicht vollständig geprüft.'}" Foreground="#E9B86B" TextWrapping="Wrap" LineHeight="21" Margin="0,0,0,18" Visibility="Collapsed" />
                                <StackPanel x:Name="OfflineDeviceOverview" Visibility="Collapsed">
                                    <TextBlock Text="{local:Tr Key='Offline-Profil'}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                                    <TextBlock Text="{local:Tr Key='Für dieses Modell kannst du Profile erstellen. Übertragen und Firmwarewechsel sind noch nicht verfügbar.'}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" LineHeight="21" />
                                </StackPanel>
                                <Grid x:Name="DeviceHardwareOverview" Grid.IsSharedSizeScope="True">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                                    <Grid Margin="0,0,24,0">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" SharedSizeGroup="DeviceActionTitle" /><RowDefinition Height="Auto" SharedSizeGroup="DeviceActionInfo" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <TextBlock Text="{local:Tr Key='Firmware'}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />
                                        <StackPanel Grid.Row="1" Margin="0,0,0,14">
                                            <TextBlock x:Name="DeviceFirmwareVersionText" Text="{local:Tr Key='Version noch nicht geprüft'}" Style="{StaticResource HelpText}" />
                                            <TextBlock x:Name="FirmwareInstallationNotice" Text="{local:Tr Key='Firmwareinstallation ist für dieses Modell noch nicht verfügbar.'}" Style="{StaticResource HelpText}" Visibility="Collapsed" Margin="0,8,0,0" />
                                            <StackPanel x:Name="ExperimentalSetupActions" Visibility="Collapsed" Margin="0,10,0,0">
                                                <Button Content="{local:Tr Key='Gerät einrichten'}" local:UiIcons.Kind="chip" Click="SetupDevice_Click" HorizontalAlignment="Left" />
                                                <Button Content="{local:Tr Key='Original-Firmware wiederherstellen'}" local:UiIcons.Kind="restore" Click="RestoreSetupDevice_Click" HorizontalAlignment="Left" Margin="0,10,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Button x:Name="ManageFirmwareButton" Grid.Row="2" local:UiIcons.Kind="chip" Content="{local:Tr Key='Firmware verwalten'}" Click="Firmware_Click" HorizontalAlignment="Left" MinHeight="37" Padding="12,9" />
                                    </Grid>
                                    <Grid x:Name="DeviceRecoveryOverview" Grid.Column="1">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <Border BorderBrush="{StaticResource Stroke}" BorderThickness="1,0,0,0" Padding="24,0" Margin="0,0,0,0">
                                            <Grid>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto" SharedSizeGroup="DeviceActionTitle" /><RowDefinition Height="Auto" SharedSizeGroup="DeviceActionInfo" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                <TextBlock Text="{local:Tr Key='Sicherungen'}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />
                                                <TextBlock x:Name="CaptureStateText" Grid.Row="1" Style="{StaticResource HelpText}" Margin="0,0,0,14" />
                                                <Button Grid.Row="2" local:UiIcons.Kind="shield" Content="{local:Tr Key='Sicherungen ansehen'}" Click="Backup_Click" HorizontalAlignment="Left" MinHeight="37" Padding="12,9" />
                                            </Grid>
                                        </Border>
                                        <Border x:Name="OriginalFirmwareSection" Grid.Column="1" BorderBrush="{StaticResource Stroke}" BorderThickness="1,0,0,0" Padding="24,0,0,0">
                                            <Grid>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto" SharedSizeGroup="DeviceActionTitle" /><RowDefinition Height="Auto" SharedSizeGroup="DeviceActionInfo" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                <TextBlock Text="{local:Tr Key='Original-Firmware wiederherstellen'}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12" />
