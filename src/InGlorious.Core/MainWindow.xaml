                                <StackPanel x:Name="KeyBindingPanel">
                                    <UniformGrid x:Name="KnobModeTabs" Columns="2" Margin="0,0,0,18" Height="38" Visibility="Collapsed">
                                        <Button x:Name="KnobPresetModeButton" Content="{local:Tr Key='Vorlagen'}" Click="KnobPresetMode_Click" Style="{StaticResource EditorSectionButton}"/>
                                        <Button x:Name="KnobManualModeButton" Content="{local:Tr Key='Manuell'}" Click="KnobManualMode_Click" Style="{StaticResource EditorSectionButton}"/>
                                    </UniformGrid>
                                    <UniformGrid x:Name="KnobManualTargets" Columns="3" Margin="0,0,0,16" Visibility="Collapsed">
                                        <Button x:Name="KnobLeftTarget" local:UiIcons.Kind="rotate-left" Content="{local:Tr Key='Links'}" ToolTip="{local:Tr Key='Nach links drehen'}" AutomationProperties.Name="{local:Tr Key='Nach links drehen'}" Tag="encoder:ccw" Click="KnobManualTarget_Click" Margin="0,0,4,0" Padding="5,8"/>
                                        <Button x:Name="KnobRightTarget" local:UiIcons.Kind="rotate-right" Content="{local:Tr Key='Rechts'}" ToolTip="{local:Tr Key='Nach rechts drehen'}" AutomationProperties.Name="{local:Tr Key='Nach rechts drehen'}" Tag="encoder:cw" Click="KnobManualTarget_Click" Margin="0,0,4,0" Padding="5,8"/>
                                        <Button x:Name="KnobPressTarget" Content="{local:Tr Key='Drücken'}" Tag="press" Click="KnobManualTarget_Click"/>
                                    </UniformGrid>
                                <StackPanel x:Name="KnobPresetPanel" Margin="0,0,0,14" Visibility="Collapsed">
                                    <TextBlock Text="{local:Tr Key='Drehen'}" Style="{StaticResource HelpText}" Margin="0,0,0,7" />
                                    <ComboBox x:Name="KnobPresetChoice" DisplayMemberPath="Label" SelectionChanged="KnobPreset_SelectionChanged" Margin="0,0,0,8" />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{local:Tr Key='Schritte pro Rastung'}" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="KnobStepChoice" Grid.Column="1" SelectionChanged="KnobStep_SelectionChanged"/>
                                    </Grid>
                                    <TextBlock Text="{local:Tr Key='Gilt für Lautstärke, Helligkeit, Scrollen und Zoom.'}" Style="{StaticResource HelpText}" Margin="0,0,0,10"/>
                                    <StackPanel x:Name="KnobUndoLayoutPanel" Margin="0,0,0,10" Visibility="Collapsed">
                                        <TextBlock Text="{local:Tr Key='Tastaturlayout für Rückgängig'}" Style="{StaticResource HelpText}" Margin="0,0,0,5"/>
                                        <ComboBox x:Name="KnobUndoLayoutChoice" SelectionChanged="KnobUndoLayout_SelectionChanged"/>
                                    </StackPanel>
                                    <CheckBox x:Name="KnobCycleCheck" Content="{local:Tr Key='Lange drücken: Funktion wechseln'}" Click="KnobCycle_Click" />
                                    <Button x:Name="KnobCycleOptionsButton" Content="{local:Tr Key='Reihenfolge …'}" Click="KnobCycleOptions_Click" Margin="0,8,0,0" Visibility="Collapsed"/>
                                    <TextBlock x:Name="KnobCycleHint" Style="{StaticResource HelpText}" Margin="0,7,0,0" />
                                </StackPanel>
                                    <StackPanel x:Name="KnobShortPressPanel" Margin="0,4,0,0" Visibility="Collapsed">
                                        <Border Style="{StaticResource PanelDivider}"/>
                                        <TextBlock Text="{local:Tr Key='Kurzes Drücken'}" Style="{StaticResource SectionTitle}"/>
                                        <ComboBox x:Name="KnobPressModeChoice" Margin="0,8,0,0" AutomationProperties.Name="{local:Tr Key='Kurzes Drücken'}" SelectionChanged="KnobPressMode_SelectionChanged"/>
                                        <ComboBox x:Name="KnobPressFunctionChoice" Margin="0,8,0,0" DisplayMemberPath="Label" SelectedValuePath="Bit" AutomationProperties.Name="{local:Tr Key='Funktion'}" SelectionChanged="KnobPressFunction_SelectionChanged"/>
                                        <ComboBox x:Name="KnobPressChoice" Margin="0,8,0,0" DisplayMemberPath="Label" SelectedValuePath="Code" IsTextSearchEnabled="True" TextSearch.TextPath="Label" MaxDropDownHeight="320" AutomationProperties.Name="{local:Tr Key='Kurzes Drücken'}" SelectionChanged="KnobPress_SelectionChanged"/>
                                    </StackPanel>
                                    <StackPanel x:Name="ManualBindingEditor">
                                <TextBlock x:Name="CurrentBindingText" Style="{StaticResource HelpText}" Margin="0,0,0,13" />
                                <TextBlock x:Name="NumpadNumLockHint" Text="{local:Tr Key='Für Ziffern Num-Lock einschalten. Standardbelegung: Fn + 0.'}" Style="{StaticResource HelpText}" Margin="0,0,0,13" Visibility="Collapsed" />
                                <ComboBox x:Name="BindingCategory" SelectionChanged="BindingCategory_SelectionChanged" SelectedIndex="0" Margin="0,0,0,10">
                                    <ComboBoxItem Content="{local:Tr Key='Alle Funktionen'}" />
                                    <ComboBoxItem Content="{local:Tr Key='Buchstaben und Zahlen'}" />
                                    <ComboBoxItem Content="{local:Tr Key='Navigation und Bearbeiten'}" />
                                    <ComboBoxItem Content="{local:Tr Key='Funktionstasten'}" />
                                    <ComboBoxItem Content="{local:Tr Key='Ziffernblock'}" />
                                    <ComboBoxItem Content="{local:Tr Key='Medien'}" />
                                    <ComboBoxItem Content="{local:Tr Key='Strg, Shift, Alt …'}" />
                                    <ComboBoxItem Content="{local:Tr Key='Ebenen'}" />
                                    <ComboBoxItem Content="{local:Tr Key='Makros'}" />
                                    <ComboBoxItem Content="{local:Tr Key='Beleuchtung'}" />
                                </ComboBox>
                                <TextBlock x:Name="BindingSearchLabel" Text="{local:Tr Key='Taste oder Funktion suchen'}" Style="{StaticResource HelpText}" Margin="0,0,0,7" />
                                <Grid Margin="0,0,0,8">
                                    <TextBox x:Name="BindingSearch" TextChanged="BindingSearch_TextChanged" ToolTip="{local:Tr Key='Tasten und Funktionen suchen'}" />
                                    <TextBlock Text="{local:Tr Key='z. B. Enter, Lautstärke …'}" Foreground="#919BA6" FontSize="11" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=BindingSearch}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <ListBox x:Name="BindingChoice" ItemTemplate="{StaticResource OptionLabelTemplate}" SelectedValuePath="Code" Height="220" SelectionChanged="BindingChoice_SelectionChanged" />
                                <TextBlock x:Name="BindingFunctionHint" Style="{StaticResource HelpText}" Margin="0,9,0,0" Visibility="Collapsed" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel x:Name="SliderPanel" Visibility="Collapsed">
                                    <TextBlock Text="{local:Tr Key='Funktion'}" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                                    <ComboBox x:Name="SliderModeChoice" SelectionChanged="SliderModeChoice_SelectionChanged">
                                        <ComboBoxItem Content="{local:Tr Key='Deaktiviert'}" />
                                        <ComboBoxItem Content="{local:Tr Key='MIDI-Controller'}" />
                                        <ComboBoxItem Content="{local:Tr Key='Lautstärke relativ ändern'}" />
                                        <ComboBoxItem Content="{local:Tr Key='Beleuchtung dimmen'}" />
                                    </ComboBox>
                                    <TextBlock x:Name="SliderModeHint" Text="{local:Tr Key='Keine Funktion bei Reglerbewegung.'}" Style="{StaticResource OptionalHelp}" Margin="0,9,0,13" />
                                    <StackPanel x:Name="MidiFields" Visibility="Collapsed">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,5,0">
                                                <TextBlock Text="{local:Tr Key='Kanal'}" Style="{StaticResource HelpText}" Margin="0,0,0,6" />
                                                <TextBox x:Name="MidiChannel" Text="1" AutomationProperties.Name="{local:Tr Key='Kanal'}" ToolTip="{local:Tr Key='MIDI-Kanal 1–16'}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                                <TextBlock Text="{local:Tr Key='Controller'}" Style="{StaticResource HelpText}" Margin="0,0,0,6" />
                                                <TextBox x:Name="MidiController" Text="62" AutomationProperties.Name="{local:Tr Key='Controller'}" ToolTip="{local:Tr Key='MIDI-Controller 0–127'}" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                    <Border x:Name="SliderSharedBrightnessPanel" Visibility="Collapsed" Background="#202428" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,2,0,4">
                                        <StackPanel>
                                            <CheckBox x:Name="SharedBrightnessToggle" Click="SharedBrightness_Click" VerticalContentAlignment="Top" AutomationProperties.Name="{local:Tr Key='GMMK Numpad und Tastatur gemeinsam dimmen'}">
                                                <TextBlock Text="{local:Tr Key='GMMK Numpad und Tastatur gemeinsam dimmen'}" TextWrapping="Wrap" Foreground="{StaticResource Text}" />
                                            </CheckBox>
                                            <TextBlock x:Name="SharedBrightnessInfo" Style="{StaticResource HelpText}" Margin="0,10,0,0"/>
                                            <TextBlock x:Name="SharedBrightnessStatus" Style="{StaticResource HelpText}" Foreground="{StaticResource Accent}" Visibility="Collapsed" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Expander x:Name="SliderCalibration" Header="{local:Tr Key='Reglerbereich'}" IsExpanded="False" Margin="0,14,0,0">
                                        <StackPanel Margin="0,8,0,0">
                                            <TextBlock Text="{local:Tr Key='Nur anpassen, wenn der Regler nicht den gesamten Bereich erreicht.'}" Style="{StaticResource HelpText}" Margin="0,0,0,10" />
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,5,0">
                                                    <TextBlock Text="{local:Tr Key='Minimum'}" Style="{StaticResource HelpText}" Margin="0,0,0,6" />
                                                    <TextBox x:Name="SliderMinimum" Text="0" AutomationProperties.Name="{local:Tr Key='Minimum'}" ToolTip="{local:Tr Key='Untere Grenze des Reglerwerts (0–1023)'}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                                    <TextBlock Text="{local:Tr Key='Maximum'}" Style="{StaticResource HelpText}" Margin="0,0,0,6" />
                                                    <TextBox x:Name="SliderMaximum" Text="1023" AutomationProperties.Name="{local:Tr Key='Maximum'}" ToolTip="{local:Tr Key='Obere Grenze des Reglerwerts (0–1023)'}" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Expander>
                                    <Button x:Name="ApplySliderButton" local:UiIcons.Kind="check" Content="{local:Tr Key='Regler übernehmen'}" Click="ApplySlider_Click" Style="{StaticResource PrimaryButton}" Margin="0,20,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel x:Name="LayerPanel" Visibility="Collapsed">
                                <TextBlock Text="{local:Tr Key='Ebenenwechsel zuweisen'}" Style="{StaticResource SectionTitle}" />
                                <TextBlock x:Name="LayerSwitchSteps" Style="{StaticResource HelpText}" Margin="0,7,0,14" />
                                <TextBlock x:Name="LayerAssignmentSource" Style="{StaticResource HelpText}" Foreground="{StaticResource Accent}" Margin="0,0,0,14" />
                                <Label Content="{local:Tr Key='Zielebene'}" Target="{Binding ElementName=TargetLayer}" Foreground="{StaticResource Text}" Padding="0" Margin="0,0,0,7" />
                                <ComboBox x:Name="TargetLayer" SelectedIndex="1" SelectionChanged="LayerSwitchMode_SelectionChanged">
                                    <ComboBoxItem Content="{local:Tr Key='Ebene 0 · Basis'}" />
                                    <ComboBoxItem Content="{local:Tr Key='Ebene 1'}" />
                                    <ComboBoxItem Content="{local:Tr Key='Ebene 2'}" />
                                    <ComboBoxItem Content="{local:Tr Key='Ebene 3'}" />
                                </ComboBox>
                                <Label Content="{local:Tr Key='Verhalten'}" Target="{Binding ElementName=LayerSwitchMode}" Foreground="{StaticResource Text}" Padding="0" Margin="0,12,0,7" />
                                <ComboBox x:Name="LayerSwitchMode" SelectedIndex="0" SelectionChanged="LayerSwitchMode_SelectionChanged">
                                    <ComboBoxItem Content="{local:Tr Key='Beim Halten (Fn)'}" />
                                    <ComboBoxItem Content="{local:Tr Key='Ein-/ausschalten'}" />
                                    <ComboBoxItem Content="{local:Tr Key='Direkt wechseln'}" />
                                </ComboBox>
                                <TextBlock x:Name="LayerSwitchHint" Style="{StaticResource HelpText}" Margin="0,9,0,0" />
                                <Button x:Name="AssignLayerSwitchButton" local:UiIcons.Kind="check" Content="{local:Tr Key='Dieser Taste zuweisen'}" Click="AssignLayerSwitch_Click" Style="{StaticResource PrimaryButton}" Margin="0,14,0,0" />
                                <TextBlock x:Name="LayerFnExample" Style="{StaticResource OptionalHelp}" Margin="0,10,0,0" />
                                <Border Style="{StaticResource PanelDivider}" />
                                <TextBlock Text="{local:Tr Key='Belegung darunter'}" Style="{StaticResource SectionTitle}" />
                                <TextBlock x:Name="TransparentBindingHint" Style="{StaticResource HelpText}" Margin="0,7,0,12" />
                                <Button x:Name="AssignTransparentButton" Content="{local:Tr Key='Belegung darunter verwenden'}" Click="AssignTransparent_Click" FontSize="11" />
                                <Border Style="{StaticResource PanelDivider}" />
                                <TextBlock Text="{local:Tr Key='Ebene benennen'}" Style="{StaticResource SectionTitle}" />
                                <TextBox x:Name="LayerName" MaxLength="80" ToolTip="{local:Tr Key='Name der ausgewählten Ebene'}" Margin="0,10,0,0" />
                                <Button Content="{local:Tr Key='Namen übernehmen'}" Click="RenameLayer_Click" FontSize="11" Margin="0,9,0,0" />
                                <Border Style="{StaticResource PanelDivider}" />
                                <TextBlock Text="{local:Tr Key='Ebene kopieren'}" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{local:Tr Key='Belegungen, Farben und Effekte übernehmen. Der Name der Zielebene bleibt erhalten.'}" Style="{StaticResource OptionalHelp}" Margin="0,7,0,10" />
                                <ComboBox x:Name="CopyTargetLayer" />
                                <Button local:UiIcons.Kind="copy" Content="{local:Tr Key='In Zielebene kopieren'}" Click="CopyLayer_Click" FontSize="11" Margin="0,9,0,0" />
                                <TextBlock Text="{local:Tr Key='Vorhandene Einstellungen der Zielebene werden ersetzt. Rückgängig mit Strg+Z.'}" Style="{StaticResource OptionalHelp}" Margin="0,7,0,0" />
                                <Border Style="{StaticResource PanelDivider}" />
                                <TextBlock Text="{local:Tr Key='Ebene vergleichen'}" Style="{StaticResource SectionTitle}" />
                                <ComboBox x:Name="CompareLayer" SelectionChanged="CompareLayer_SelectionChanged" Margin="0,10,0,0" />
                                <TextBlock x:Name="LayerComparison" Style="{StaticResource HelpText}" Margin="0,8,0,0" />
                            </StackPanel>
                            <StackPanel x:Name="MacroPanel" Visibility="Collapsed">
                                <TextBlock Text="{local:Tr Key='Schritt bearbeiten'}" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{local:Tr Key='Links einen Schritt auswählen. Neue Tastendrücke verwenden die hier gewählte Taste.'}" Style="{StaticResource OptionalHelp}" Margin="0,7,0,14" />
                                <ComboBox x:Name="StepKeyChoice" ItemTemplate="{StaticResource OptionLabelTemplate}" SelectedValuePath="Code" />
                                <TextBlock Text="{local:Tr Key='Pause in Millisekunden'}" Style="{StaticResource HelpText}" Margin="0,11,0,7" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="StepDelay" Text="100" ToolTip="{local:Tr Key='Wartezeit in Millisekunden'}" />
                                    <TextBlock Grid.Column="1" Text="{local:Tr Key='ms'}" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="8,0,5,0" />
                                </Grid>
                                <Button Content="{local:Tr Key='Schritt ändern'}" Click="EditStep_Click" FontSize="11" Margin="0,9,0,0" />
                                <Border Style="{StaticResource PanelDivider}" />
                                <TextBlock Text="{local:Tr Key='Makro auf eine Taste legen'}" Style="{StaticResource SectionTitle}" />
                                <TextBlock x:Name="MacroAssignmentHint" Style="{StaticResource OptionalHelp}" Margin="0,7,0,0" />
                                <Button x:Name="AssignMacroButton" Content="{local:Tr Key='Taste auswählen …'}" Click="AssignMacro_Click" Style="{StaticResource PrimaryButton}" FontSize="12" Margin="0,12,0,0" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                    <Border Grid.Row="3" Visibility="{Binding Visibility, ElementName=BindingPanel}" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0">
                        <StackPanel>
                            <StackPanel x:Name="ManualBindingActions" Margin="0,0,0,14">
                                <Button local:UiIcons.Kind="check" x:Name="AssignBindingButton" Content="{local:Tr Key='Belegung zuweisen'}" Click="AssignBinding_Click" Style="{StaticResource PrimaryButton}" Margin="0,11,0,0" />
                                <UniformGrid Columns="2" Margin="0,8,0,0">
                                    <Button x:Name="ResetBindingButton" Content="{local:Tr Key='Standard'}" Click="ResetBinding_Click" FontSize="11" Margin="0,0,3,0" />
                                    <Button x:Name="DisableBindingButton" Content="{local:Tr Key='Deaktivieren'}" Click="DisableBinding_Click" FontSize="11" Margin="3,0,0,0" />
                                </UniformGrid>
                            </StackPanel>
                        <UniformGrid Columns="2">
                            <Button x:Name="ImportKeyBindingsButton" local:UiIcons.Kind="import" Content="{local:Tr Key='Importieren …'}" Click="ImportKeyBindings_Click" FontSize="11" Padding="7,9" Margin="0,0,3,0" />
                            <Button x:Name="ExportKeyBindingsButton" local:UiIcons.Kind="export" Content="{local:Tr Key='Exportieren …'}" Click="ExportKeyBindings_Click" FontSize="11" Padding="7,9" Margin="3,0,0,0" />
                        </UniformGrid>
                        </StackPanel>
                    </Border>
                    <Border x:Name="ApplyEffectHost" Grid.Row="3" Visibility="Collapsed" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0">
                        <Button local:UiIcons.Kind="check" x:Name="ApplyEffectButton" Content="{local:Tr Key='Effekt übernehmen'}" Click="ApplyEffect_Click" Style="{StaticResource PrimaryButton}" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="#1C1F22" BorderBrush="#353A40" BorderThickness="0,1,0,0">
            <Grid Margin="20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                    <TextBlock x:Name="StatusText" Text="{local:Tr Key='Bereit'}" Foreground="#D5DBE3" FontSize="11" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="DeviceSaveState" Foreground="#A0A7B0" FontSize="11" Margin="0,4,0,0" />
                </StackPanel>
                <Button local:UiIcons.Kind="import" x:Name="ReadDeviceButton" Grid.Column="1" Content="{local:Tr Key='Von Tastatur laden'}" Click="ReadFromDevice_Click" VerticalAlignment="Center" Padding="14,10" Margin="0,0,10,0" />
                <Button local:UiIcons.Kind="export" x:Name="TransferButton" Grid.Column="2" Content="{local:Tr Key='Auf Tastatur übertragen'}" Click="PrepareTransfer_Click" Padding="18,10" VerticalAlignment="Center" Style="{StaticResource PrimaryButton}" />
            </Grid>
        </Border>
    </Grid>
</Window>
