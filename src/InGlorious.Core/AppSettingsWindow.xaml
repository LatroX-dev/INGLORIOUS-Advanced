<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="InGlorious.Core.AppSettingsWindow" Title="{local:Tr Key='App-Einstellungen · INGLORIOUS Advanced'}" Width="580" Height="630" MinWidth="520" MinHeight="580" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource WindowBackground}" Foreground="{StaticResource Text}" FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" xmlns:local="clr-namespace:InGlorious.Core">
    <Border Background="{StaticResource WindowBackground}">
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="{local:Tr Key='App-Einstellungen'}" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,22" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                <StackPanel>
                    <Label Content="{local:Tr Key=Sprache}" Target="{Binding ElementName=LanguageChoice}" Foreground="{StaticResource Text}" Padding="0" Margin="0,0,0,6" />
                    <ComboBox x:Name="LanguageChoice" SelectedValuePath="Code" MinHeight="36" Margin="0,0,0,20">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding NativeName}" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <Label Content="{local:Tr Key='Startgerät'}" Target="{Binding ElementName=StartDeviceChoice}" Foreground="{StaticResource Text}" Padding="0" Margin="0,0,0,6" />
                    <ComboBox x:Name="StartDeviceChoice" SelectedValuePath="Tag" MinHeight="36" />
                    <CheckBox x:Name="RememberSizeCheck" Content="{local:Tr Key='Fenstergröße merken'}" Foreground="{StaticResource Text}" Margin="0,22,0,16" />
                    <CheckBox x:Name="ShowHelpCheck" Content="{local:Tr Key='Bedienhilfen anzeigen'}" Foreground="{StaticResource Text}" />
                    <Border Height="1" Background="{StaticResource Stroke}" Margin="0,23" />
                    <Button x:Name="SetupDeviceButton" Content="{local:Tr Key='Gerät einrichten'}" HorizontalAlignment="Left" Click="SetupDevice_Click" />
                    <Button x:Name="RestoreDeviceButton" Content="{local:Tr Key='Original-Firmware wiederherstellen'}" HorizontalAlignment="Left" Click="RestoreDevice_Click" Margin="0,10,0,0" />
                    <Border Height="1" Background="{StaticResource Stroke}" Margin="0,23" />
                    <TextBlock Text="{local:Tr Key='Profilordner'}" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock x:Name="ProjectFolderText" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,10" />
                    <Button x:Name="OpenFolderButton" Content="{local:Tr Key='Ordner öffnen'}" HorizontalAlignment="Left" Click="OpenFolder_Click" />
                    <TextBlock x:Name="VersionText" Foreground="{StaticResource Muted}" Margin="0,24,0,0" />
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{StaticResource Accent}" Margin="0,16,0,0" />
                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="{local:Tr Key='Abbrechen'}" IsCancel="True" MinWidth="100" Margin="0,0,10,0" />
                <Button x:Name="SaveButton" Content="{local:Tr Key='Speichern'}" IsDefault="True" MinWidth="100" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
